# Copy this file to `.env` (git-ignored) for local overrides.
#
# Variables prefixed with VITE_ are embedded in the browser bundle and are PUBLIC.
# Never put secrets, tokens, private keys, or database credentials here.

# Base URL of the Raksham backend API. The value below is an illustrative local
# default only; it must match the backend team's actual configuration.
VITE_API_BASE_URL=http://localhost:5000/api
